# ==========================================
# alpedo.app - Variables de Entorno de Producción
# ==========================================

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://alpedo_user:password@localhost:5432/alpedo_db

# Clave de API de Google Gemini (Asistente Financiero "El Kape" y "¿Me da el cuero?")
# Obtenela gratis en https://aistudio.google.com/
GEMINI_API_KEY=
# Opcional: modelo Gemini compatible con generateContent
GEMINI_MODEL=gemini-3.5-flash-lite

# Usar false en desarrollo local; true tras configurar HTTPS público
ENABLE_HTTPS=false
